<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The hardened runtime denies microphone access without this, whatever
       the toggle in Privacy & Security says. BlackHole is an input device. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
