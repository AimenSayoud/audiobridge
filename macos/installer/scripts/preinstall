#!/bin/bash
# Quit a running copy so the bundle is not replaced underneath itself.
# Never fatal: a failure here must not block the install.
CONSOLE_UID=$(stat -f %u /dev/console 2>/dev/null || echo 0)
if [ "$CONSOLE_UID" != "0" ]; then
  launchctl asuser "$CONSOLE_UID" osascript -e 'quit app "Tethertone"' >/dev/null 2>&1 || true
  sleep 1
  launchctl asuser "$CONSOLE_UID" pkill -f "Tethertone.app/Contents/MacOS/Tethertone" >/dev/null 2>&1 || true
fi
exit 0
