#!/bin/bash
# Launch as the logged-in user, not as root — the installer runs privileged and
# an app started that way would write root-owned preferences.
CONSOLE_UID=$(stat -f %u /dev/console 2>/dev/null || echo 0)
if [ "$CONSOLE_UID" != "0" ]; then
  launchctl asuser "$CONSOLE_UID" open -a "/Applications/AudioBridge.app" >/dev/null 2>&1 || true
fi
exit 0
